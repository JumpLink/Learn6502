{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 120,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/*.json",
    "**/*.jsonc",
    "**/*.json5",
    "**/*.css",
    "**/*.scss",
    "**/*.sass",
    "**/*.less",
    "**/*.html",
    "**/*.htm",
    "**/*.md",
    "**/*.mdx",
    "**/*.markdown",
    "**/*.yml",
    "**/*.yaml",
    "**/*.toml",
    "**/*.blp",
    // GENERATED by `@gjsify/vite-plugin-blueprint` beside each `.blp` and committed per gjsify
    // ADR 0088 §4, so `gjsify blueprint types --check` has a real artifact to hold. The emitter
    // reads `printWidth` out of `.oxfmtrc.json` and hardcodes the indent at four spaces (gjsify
    // `packages/infra/blueprint/src/typed-exports.mjs`), so under this file's `tabWidth: 2` oxfmt
    // rewrites all 24 of them — and a hand-reindented sidecar would then fail the drift check.
    // Excluded from the formatter, not reindented.
    "**/*.d.blp.ts",
    "**/node_modules",
    "**/build-aux",
    "**/dist",
    "**/lib",
    "**/build",
    "**/build-dir",
    "**/builddir",
    "**/flatpak-build",
    "**/.flatpak-builder",
    "**/repo",
    "**/coverage",
    "**/refs",
    "**/references",
    "**/@types",
    "**/templates",
    "**/prebuilds",
    "**/.yarn",
    "**/_site",
    "**/_includes",
    "**/platforms",
    "packages/app-android/app/i18n",
    "**/*.gresource",
    "**/*.compiled",
    "**/*.metainfo.xml"
  ]
}
