{
  "name": "@learn6502/learn",
  "version": "0.6.5",
  "description": "Learn 6502 assembly",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:mdx": "node esbuild.js",
    "build:js": "node dist/index.js",
    "build": "gjsify run build:mdx && gjsify run build:js && gjsify run build:copy",
    "build:copy": "cp -r dist/tutorial.ns.xml ../app-android/app/mdx/tutorial.xml && cp -r dist/quick-help.ns.xml ../app-android/app/mdx/quick-help.xml",
    "clear": "rm -rf dist"
  },
  "author": "Nick Morgan, Pascal Garber",
  "license": "CC-BY-4.0",
  "devDependencies": {
    "@gjsify/cli": "^0.4.41",
    "@mdx-js/esbuild": "^3.1.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "nano-jsx": "^0.2.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@learn6502/examples": "workspace:^"
  }
}
