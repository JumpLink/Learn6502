{
  "name": "@learn6502/learn",
  "private": true,
  "version": "0.7.0",
  "description": "Learn 6502 assembly",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:mdx": "gjsify build tsx/index.tsx --app gjs --globals node --outfile dist/index.js",
    "build:js": "gjsify run dist/index.js",
    "build": "gjsify run build:mdx && gjsify run build:js && gjsify run build:copy",
    "build:copy": "cp -r dist/tutorial.ns.xml ../app-android/app/mdx/tutorial.xml && cp -r dist/quick-help.ns.xml ../app-android/app/mdx/quick-help.xml",
    "clear": "rm -rf dist"
  },
  "author": "Nick Morgan, Pascal Garber",
  "license": "CC-BY-4.0",
  "gjsify": {
    "loaders": {
      ".asm": "text"
    },
    "bundler": {
      "transform": {
        "jsx": {
          "runtime": "automatic",
          "importSource": "nano-jsx/esm"
        },
        "define": {
          "window": "undefined"
        }
      },
      "plugins": [
        {
          "name": "@mdx-js/rollup",
          "options": {
            "jsxImportSource": "nano-jsx/esm"
          }
        }
      ]
    }
  },
  "devDependencies": {
    "@gjsify/cli": "^0.10.0",
    "@gjsify/dom-elements": "^0.10.0",
    "@mdx-js/rollup": "^3.1.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "nano-jsx": "^0.2.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@learn6502/examples": "^0.7.0"
  }
}
