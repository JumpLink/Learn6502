"_A_full_list_of_the_6502_instruction_set_is__a_href__https___web_archive_org_web_20250915114440_http___www_6502_org_tutorials_6502opcodes_html__available_here__a__and__a_href__https___web_archive_org_web_20210626042844_http___www_obelisk_me_uk_6502_reference_html__here__a___I_usually_refer_to_both_pages_as_they_have_their_strengths_and_weaknesses___These_pages_detail_the_arguments_to_each_instruction__which_registers_they_use__and_which_flags_they_set__They_are_your_bible__1smW2o" = "Pełna lista zestawu instrukcji 6502 jest <a href=\"https://web.archive.org/web/20250915114440/http://www.6502.org/tutorials/6502opcodes.html\">dostępna tutaj</a> i <a href=\"https://web.archive.org/web/20210626042844/http://www.obelisk.me.uk/6502/reference.html\">tutaj</a> (zwykle odwołuję się do obu stron, ponieważ mają swoje mocne i słabe strony). Te strony szczegółowo opisują argumenty każdej instrukcji, których rejestrów używają i które flagi ustawiają. Są Twoją biblią.";
"_A_GitHub_issue_has_been_opened_in_your_browser__Please_review_and_submit_it_there_to_complete_your_contribution__Once_approved__your_example_will_be_included_in_the_next_release___Should_your_example_be_too_large__the_complete_content_will_be_copied_to_your_clipboard_for_manual_pasting_into_the_GitHub_issue__uWiCj" = "W Twojej przeglądarce otwarto zgłoszenie na GitHub. Przejrzyj i prześlij je tam, aby ukończyć swój wkład. Po zatwierdzeniu Twój przykład zostanie uwzględniony w następnej wersji.\n\nJeśli Twój przykład jest zbyt duży, kompletna zawartość zostanie skopiowana do schowka do ręcznego wklejenia w zgłoszenie na GitHub.";
"__tt_init__tt__and__tt_loop__tt__are_both_subroutines___tt_init__tt__initializes_the_game_state__and__tt_loop__tt__is_the_main_game_loop__Z1xARaG" = "<tt>init</tt> i <tt>loop</tt> to oba podprogramy. <tt>init</tt> inicjalizuje stan gry, a <tt>loop</tt> to główna pętla gry.";
"__tt_checkSnakeCollision__tt__loops_through_the_snake_s_body_segments__checking_each_byte_pair_against_the_head_pair__If_there_is_a_match__then_game_over__2lhmuJ" = "<tt>checkSnakeCollision</tt> przechodzi przez segmenty ciała węża, sprawdzając każdą parę bajtów względem pary głowy. Jeśli jest dopasowanie, to koniec gry.";
"__tt_a9__tt__and__tt_c9__tt__are_the_processor_opcodes_for_immediate_addressed__tt_LDA__tt__and__tt_CMP__tt__respectively___tt_01__tt__and__tt_02__tt__are_the_arguments_to_these_instructions___tt_d0__tt__is_the_opcode_for__tt_BNE__tt___and_its_argument_is__tt_02__tt___This_means__skip_over_the_next_two_bytes____tt_85_22__tt___the_assembled_version_of__tt_STA__22__tt____Try_editing_the_code_so__tt_STA__tt__takes_a_two_byte_absolute_address_rather_than_a_single_byte_zero_page_address__e_g__change__tt_STA__22__tt__to__tt_STA__2222__tt____Reassemble_the_code_and_look_at_the_hexdump_again___the_argument_to__tt_BNE__tt__should_now_be__tt_03__tt___because_the_instruction_the_processor_is_skipping_past_is_now_three_bytes_long__ZkNEKa" = "<tt>a9</tt> i <tt>c9</tt> to opkody procesora dla natychmiastowo adresowanych <tt>LDA</tt> i <tt>CMP</tt> odpowiednio. <tt>01</tt> i <tt>02</tt> to argumenty tych instrukcji. <tt>d0</tt> to opkod dla <tt>BNE</tt>, a jego argument to <tt>02</tt>. To oznacza \"pomiń następne dwa bajty\" (<tt>85 22</tt>, złożona wersja <tt>STA $22</tt>). Spróbuj edytować kod tak, aby <tt>STA</tt> przyjmował dwubajtowy adres absolutny zamiast jednobajtowego adresu strony zerowej (np. zmień <tt>STA $22</tt> na <tt>STA $2222</tt>). Złóż ponownie kod i spójrz na hexdump - argument do <tt>BNE</tt> powinien teraz być <tt>03</tt>, ponieważ instrukcja, którą procesor pomija, jest teraz trzy bajty długa.";
"__tt_X__tt__holds_the_pixel_colour__and__tt_Y__tt__holds_the_position_of_the_current_pixel__The_first_loop_draws_the_current_colour_as_a_pixel__via_the__tt_A__tt__register___pushes_the_colour_to_the_stack__then_increments_the_colour_and_position__The_second_loop_pops_the_stack__draws_the_popped_colour_as_a_pixel__then_increments_the_position__As_should_be_expected__this_creates_a_mirrored_pattern__ZSPLKf" = "<tt>X</tt> przechowuje kolor piksela, a <tt>Y</tt> przechowuje pozycję bieżącego piksela. Pierwsza pętla rysuje bieżący kolor jako piksel (przez rejestr <tt>A</tt>), wkłada kolor na stos, następnie zwiększa kolor i pozycję. Druga pętla zdejmuje ze stosu, rysuje zdjęty kolor jako piksel, następnie zwiększa pozycję. Jak można się spodziewać, tworzy to wzór lustrzany.";
"__tt_SP__tt__is_the_stack_pointer__I_won_t_get_into_the_stack_yet__but_basically_this_register_is_decremented_every_time_a_byte_is_pushed_onto_the_stack__and_incremented_when_a_byte_is_popped_off_the_stack__1P8VCj" = "<tt>SP</tt> to wskaźnik stosu. Jeszcze nie będę wchodzić w szczegóły stosu, ale zasadniczo ten rejestr jest zmniejszany za każdym razem, gdy bajt jest wkładany na stos, i zwiększany gdy bajt jest zdejmowany ze stosu.";
"__tt_PC__tt__is_the_program_counter___it_s_how_the_processor_knows_at_what_point_in_the_program_it_currently_is__It_s_like_the_current_line_number_of_an_executing_script__In_the_simulator_the_code_is_assembled_starting_at_memory_location__tt__0600__tt___so__tt_PC__tt__always_starts_there__Z1aTeas" = "<tt>PC</tt> to licznik programu - w ten sposób procesor wie, w którym punkcie programu aktualnie się znajduje. To jak bieżący numer linii wykonywanego skryptu. W symulatorze kod jest składany rozpoczynając od lokalizacji pamięci <tt>$0600</tt>, więc <tt>PC</tt> zawsze tam się rozpoczyna.";
"__tt_JSR__tt__and__tt_RTS__tt____jump_to_subroutine__and__return_from_subroutine___are_a_dynamic_duo_that_you_ll_usually_see_used_together___tt_JSR__tt__is_used_to_jump_from_the_current_location_to_another_part_of_the_code___tt_RTS__tt__returns_to_the_previous_position__This_is_basically_like_calling_a_function_and_returning__budLU" = "<tt>JSR</tt> i <tt>RTS</tt> (\"skok do podprogramu\" i \"powrót z podprogramu\") to dynamiczny duet, który zwykle zobaczysz używany razem. <tt>JSR</tt> jest używany do skoku z bieżącej lokalizacji do innej części kodu. <tt>RTS</tt> powraca do poprzedniej pozycji. To jest zasadniczo jak wywołanie funkcji i powrót.";
"__tt_JMP__tt__is_an_unconditional_jump__Here_s_a_really_simple_example_to_show_it_in_action__220zvA" = "<tt>JMP</tt> to bezwarunkowy skok. Oto naprawdę prosty przykład, aby pokazać go w działaniu:";
