{
  "name": "@learn6502/app-android",
  "main": "app/app.ts",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "clear": "ns clean",
    "start": "concurrently 'yarn:start:emulator' 'yarn:start:emulator-self'",
    "start:emulator": "ns run android --emulator",
    "start:device": "ns run android",
    "start:clean": "ns run android --clean --emulator",
    "start:debug": "ns debug android",
    "start:emulator-self": "$HOME/Android/Sdk/emulator/emulator -avd Medium_Phone_API_36",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@learn6502/6502": "workspace:^",
    "@learn6502/common-ui": "workspace:^",
    "@nativescript/core": "~8.9.7",
    "@nativescript/localize": "^5.2.0",
    "@nativescript/tailwind": "^4.0.4",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@nativescript/android": "8.9.1",
    "@nativescript/types": "~8.9.1",
    "@nativescript/webpack": "^5.0.24",
    "concurrently": "^9.2.1",
    "nativescript": "^8.9.3",
    "typescript": "^5.9.2"
  }
}
