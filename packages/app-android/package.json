{
  "name": "@learn6502/app-android",
  "main": "app/app.ts",
  "version": "0.6.2",
  "private": true,
  "scripts": {
    "clear": "ns clean",
    "start": "yarn start:emulated",
    "start:emulated": "ns run android --emulator",
    "start:device": "ns run android",
    "start:clean": "ns run android --clean --emulator",
    "start:debug": "ns debug android",
    "start:emulator": "$HOME/Android/Sdk/emulator/emulator -avd Medium_Phone_API_36",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@learn6502/6502": "workspace:^",
    "@learn6502/common-ui": "workspace:^",
    "@nativescript/core": "~9.0.10",
    "@nativescript/localize": "^5.2.0",
    "@nativescript/tailwind": "^4.0.6",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@nativescript/android": "9.0.1",
    "@nativescript/types": "~9.0.0",
    "@nativescript/webpack": "^5.0.29",
    "nativescript": "^9.0.1",
    "typescript": "^5.9.3"
  }
}
