<StackLayout xmlns="http://schemas.nativescript.org/tns.xsd"
    xmlns:w="~/widgets/index">

    <!-- Registers Section -->
    <Label text="Registers" class="text-base font-medium text-on-surface my-4" />
    <w:List id="registersList" containerColor="surfaceContainerHigh">
        <w:ListItem
            id="itemA"
            headline="A"
            supporting="Accumulator: Main register for calculations"
            trailingText="$00 (0)"
            showDivider="true" />

        <w:ListItem
            id="itemX"
            headline="X"
            supporting="Index register X: Used for addressing"
            trailingText="$00 (0)"
            showDivider="true" />

        <w:ListItem
            id="itemY"
            headline="Y"
            supporting="Index register Y: Used for addressing"
            trailingText="$00 (0)"
            showDivider="true" />

        <w:ListItem
            id="itemSP"
            headline="SP"
            supporting="Stack Pointer: Points to stack position"
            trailingText="$FF (255)"
            showDivider="true" />

        <w:ListItem
            id="itemPC"
            headline="PC"
            supporting="Program Counter: Points to next instruction"
            trailingText="$0600 (1536)" />
    </w:List>

    <!-- Status Flags Section -->
    <Label text="Status Flags" class="text-base font-medium text-on-surface my-4" />
    <w:List id="flagsList" containerColor="surfaceContainerHigh">
        <w:ListItem
            id="itemFlags"
            headline="P (SR)"
            supporting="Processor Status Register: N V - B D I Z C"
            trailingText="00110000" />
    </w:List>
</StackLayout>
