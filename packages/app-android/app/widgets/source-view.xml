<GridLayout xmlns="http://schemas.nativescript.org/tns.xsd"
    xmlns:gtk="~/gtk"
    xmlns:gtksource="~/gtksource"
    rows="auto, *"
    columns="*"
    height="100%" width="100%"
    class="bg-surface">
    <!-- Mirrors packages/app-gnome/src/widgets/source-view.blp (GtkSource.View) -->
    <gtksource:View id="sourceView"
        row="0" rowSpan="2" col="0"
        autoIndent="true"
        indentWidth="4"
        showLineNumbers="{{ lineNumbers }}"
        monospace="true"
        leftMargin="12" rightMargin="12" topMargin="12" bottomMargin="12"
        editable="{{ editable }}"
        horizontalAlignment="stretch" verticalAlignment="stretch" />
    <gtk:Button id="copyButton"
        row="0" col="0"
        horizontalAlignment="right"
        verticalAlignment="top"
        label="COPY"
        visibility="{{ copyable ? 'visible' : 'collapsed' }}"
        styleClasses="flat" margin="8" />
</GridLayout>
