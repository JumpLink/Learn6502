<GridLayout xmlns="http://schemas.nativescript.org/tns.xsd"
    xmlns:gtk="~/gtk"
    rows="auto, *"
    columns="auto, *"
    height="100%" width="100%"
    class="bg-surface">
    <TextView id="lineNumbersView"
        row="0" col="0" rowSpan="2"
        editable="false"
        fontFamily="monospace"
        height="100%"
        visibility="{{ lineNumbers ? 'visible' : 'collapsed' }}"
        class="text-base p-0 m-0 vertical-top w-10 no-underline text-on-surface-variant" />
    <TextView id="textView"
        row="0" col="1" rowSpan="2"
        editable="{{ editable }}"
        fontFamily="monospace"
        height="100%"
        class="text-base p-0 m-0 vertical-top no-underline text-on-surface" />
    <gtk:Button id="copyButton"
        row="0" col="1"
        horizontalAlignment="right"
        verticalAlignment="top"
        label="COPY"
        visibility="{{ copyable ? 'visible' : 'collapsed' }}"
        styleClasses="flat" margin="8" />
</GridLayout>