{
  "compilerOptions": {
    "preserveWatchOutput": true,
    "lib": ["ESNext", "DOM"],
    "types": ["@learn6502/common-ui/global.d.ts"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "diagnostics": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "../examples/env.d.ts"]
}
