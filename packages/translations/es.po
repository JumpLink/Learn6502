#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>A</b> (Accumulator): Main register for calculations and data manipulation"
msgstr "<b>A</b> (Acumulador): Registro principal para cálculos y manipulación de datos"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>A</b> or Left Arrow key (<tt>$61</tt>)"
msgstr "<b>A</b> o tecla de flecha izquierda (<tt>$61</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>ADC/SBC</b>: Add/subtract with carry"
msgstr "<b>ADC/SBC</b>: Sumar/restar con acarreo"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Absolute,X/Y</b> (<tt>$c000,X</tt>): Add X/Y register to absolute address"
msgstr "<b>Absoluta,X/Y</b> (<tt>$c000,X</tt>): Suma el registro X/Y a la dirección absoluta"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Absolute</b> (<tt>$c000</tt>): Access any memory location"
msgstr "<b>Absoluta</b> (<tt>$c000</tt>): Accede a cualquier ubicación de memoria"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Action buttons</b>:"
msgstr "<b>Botones de acción</b>:"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>B</b> (Break): Set when BRK instruction is executed"
msgstr "<b>B</b> (Break): Se establece cuando se ejecuta la instrucción BRK"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>BEQ/BNE/BCC/BCS</b>: Branch if equal/not equal/carry clear/carry set"
msgstr "<b>BEQ/BNE/BCC/BCS</b>: Saltar si igual/no igual/acarreo borrado/acarreo establecido"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>C</b> (Carry): Set when arithmetic operations overflow a byte"
msgstr "<b>C</b> (Acarreo): Se establece cuando las operaciones aritméticas desbordan un byte"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Compare ops</b>: <tt>CMP/CPX/CPY</tt> set <tt>N/Z/C</tt> like a subtraction (register − memory) without storing a result."
msgstr "<b>Operaciones de comparación</b>: <tt>CMP/CPX/CPY</tt> establecen <tt>N/Z/C</tt> como una resta (registro − memoria) sin almacenar un resultado."

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>D</b> (Decimal): Set when processor is in BCD (Binary Coded Decimal) mode"
msgstr "<b>D</b> (Decimal): Se establece cuando el procesador está en modo BCD (Binary Coded Decimal)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
