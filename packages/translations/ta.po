msgstr "மறைமுக அட்டவணை: <tt>($c0),Y</tt>"

#. TRANSLATORS: MDX-derived text from packages/learn/tutorial.mdx
msgid "Indirect: <tt>($c000)</tt>"
msgstr "மறைமுக: <tt>($c000)</tt>"

