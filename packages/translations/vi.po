msgid "<b><tt>$7</tt></b>: Yellow (<tt>#eeee77</tt>)"
msgstr "<b><tt>$7</tt></b>: Vàng (<tt>#eeee77</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
