msgstr "<b><tt>$8</tt></b>: Cam (<tt>#dd8855</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b><tt>$9</tt></b>: Brown (<tt>#664400</tt>)"
msgstr "<b><tt>$9</tt></b>: Nâu (<tt>#664400</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b><tt>$FE</tt></b>: Random number generator (reads as a random value 0-255)"
msgstr "<b><tt>$FE</tt></b>: Trình tạo số ngẫu nhiên (đọc dưới dạng giá trị ngẫu nhiên 0-255)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b><tt>$FF</tt></b>: Last pressed key (ASCII code)"
msgstr "<b><tt>$FF</tt></b>: Phím được nhấn lần cuối (mã ASCII)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b><tt>$a</tt></b>: Light red (<tt>#ff7777</tt>)"
msgstr "<b><tt>$a</tt></b>: Đỏ nhạt (<tt>#ff7777</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b><tt>$b</tt></b>: Dark grey (<tt>#333333</tt>)"
msgstr "<b><tt>$b</tt></b>: Xám đậm (<tt>#333333</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b><tt>$c</tt></b>: Grey (<tt>#777777</tt>)"
msgstr "<b><tt>$c</tt></b>: Xám (<tt>#777777</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b><tt>$d</tt></b>: Light green (<tt>#aaff66</tt>)"
msgstr "<b><tt>$d</tt></b>: Xanh nhạt (<tt>#aaff66</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b><tt>$e</tt></b>: Light blue (<tt>#0088ff</tt>)"
msgstr "<b><tt>$e</tt></b>: Xanh nhạt (<tt>#0088ff</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b><tt>$f</tt></b>: Light grey (<tt>#bbbbbb</tt>)"
msgstr "<b><tt>$f</tt></b>: Màu xám nhạt (<tt>#bbbbbb</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>A</b> (Accumulator): Main register for calculations and data manipulation"
msgstr "<b>A</b> (Bộ tích lũy): Thanh ghi chính để tính toán và thao tác dữ liệu"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>A</b> or Left Arrow key (<tt>$61</tt>)"
msgstr "<b>A</b> hoặc phím Mũi tên trái (<tt>$61</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>ADC/SBC</b>: Add/subtract with carry"
msgstr "<b>ADC/SBC</b>: Cộng/trừ có nhớ"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Absolute,X/Y</b> (<tt>$c000,X</tt>): Add X/Y register to absolute address"
msgstr "<b>Tuyệt đối,X/Y</b> (<tt>$c000,X</tt>): Thêm thanh ghi X/Y vào địa chỉ tuyệt đối"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Absolute</b> (<tt>$c000</tt>): Access any memory location"
msgstr "<b>Tuyệt đối</b> (<tt>$c000</tt>): Truy cập bất kỳ vị trí bộ nhớ nào"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Action buttons</b>:"
msgstr "<b>Các nút hành động</b>:"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>B</b> (Break): Set when BRK instruction is executed"
msgstr "<b>B</b> (Ngắt): Đặt khi lệnh BRK được thực thi"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>BEQ/BNE/BCC/BCS</b>: Branch if equal/not equal/carry clear/carry set"
msgstr "<b>BEQ/BNE/BCC/BCS</b>: Phân nhánh nếu bằng/không bằng/xóa mang/tập mang"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>C</b> (Carry): Set when arithmetic operations overflow a byte"
msgstr "<b>C</b> (Carry): Đặt khi các phép tính số học tràn một byte"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Compare ops</b>: <tt>CMP/CPX/CPY</tt> set <tt>N/Z/C</tt> like a subtraction (register − memory) without storing a result."
msgstr "<b>So sánh ops</b>: <tt>CMP/CPX/CPY</tt> đặt <tt>N/Z/C</tt> giống như một phép trừ (thanh ghi − bộ nhớ) mà không lưu trữ kết quả."

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>D</b> (Decimal): Set when processor is in BCD (Binary Coded Decimal) mode"
msgstr "<b>D</b> (Thập phân): Đặt khi bộ xử lý ở chế độ BCD (Binary Coded Decimal)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>D</b> or Right Arrow key (<tt>$64</tt>)"
msgstr "<b>D</b> hoặc phím Mũi tên phải (<tt>$64</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Directional controls</b>:"
msgstr "<b>Điều khiển hướng</b>:"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Display Memory</b>: <tt>$0200</tt>-<tt>$05FF</tt> (used for screen output)"
msgstr "<b>Bộ nhớ hiển thị</b>: <tt>$0200</tt>-<tt>$05FF</tt> (dùng cho đầu ra màn hình)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>E</b> or Space key (<tt>$20</tt>)"
msgstr "<b>E</b> hoặc phím Space (<tt>$20</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>I</b> (Interrupt): Set when interrupts are disabled"
msgstr "<b>I</b> (Ngắt): Đặt khi ngắt bị tắt"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>INX/INY/DEX/DEY</b>: Increment/decrement registers"
msgstr "<b>INX/INY/DEX/DEY</b>: Thanh ghi tăng/giảm"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Immediate</b> (<tt>#$c0</tt>): Use the actual value"
msgstr "<b>Ngay lập tức</b> (<tt>#$c0</tt>): Sử dụng giá trị thực tế"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Indexed Indirect</b> (<tt>($c0,X)</tt>): Add X to zero page address, then use result as pointer to get actual target address"
msgstr "<b>Gián Tiếp Được Lập Chỉ Mục</b> (<tt>($c0,X)</tt>): Thêm X vào địa chỉ trang không, sau đó sử dụng kết quả làm con trỏ để lấy địa chỉ đích thực tế"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Indirect Indexed</b> (<tt>($c0),Y</tt>): Use zero page address as pointer to get base address, then add Y to that base"
msgstr "<b>Được Lập Chỉ Mục Gián Tiếp</b> (<tt>($c0),Y</tt>): Sử dụng địa chỉ trang không làm con trỏ để lấy địa chỉ cơ sở, sau đó thêm Y vào cơ sở đó"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Indirect</b> (<tt>($c000)</tt>): Look up address stored at given location"
msgstr "<b>Gián tiếp</b> (<tt>($c000)</tt>: Tra cứu địa chỉ được lưu trữ tại vị trí nhất định"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>JMP</b>: Unconditional jump"
msgstr "<b>JMP</b>: Nhảy vô điều kiện"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>JSR/RTS</b>: Jump to subroutine / Return from subroutine"
msgstr "<b>JSR/RTS</b>: Chuyển tới chương trình con/Trở về từ chương trình con"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>LDA/LDX/LDY</b>: Load registers"
msgstr "<b>LDA/LDX/LDY</b>: Tải thanh ghi"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>N</b> (Negative): Set when bit 7 of result is set"
msgstr "<b>N</b> (Phủ định): Đặt khi bit 7 của kết quả được đặt"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>PC</b> (Program Counter): Points to the next instruction to execute"
msgstr "<b>PC</b> (Bộ đếm chương trình): Trỏ tới lệnh tiếp theo để thực thi"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>PHA/PLA</b>: Push/pull accumulator to/from stack"
msgstr "<b>PHA/PLA</b>: Đẩy/kéo bộ tích lũy vào/từ ngăn xếp"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Program Storage</b>: Starting at <tt>$0600</tt>"
msgstr "<b>Bộ nhớ chương trình</b>: Bắt đầu từ <tt>$0600</tt>"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Q</b> or Enter/Return key (<tt>$0D</tt>)"
msgstr "<b>Q</b> hoặc phím Enter/Return (<tt>$0D</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Relative</b> (<tt>label</tt>): Branch uses signed 8‑bit offset from the next instruction (−128…+127)"
msgstr "<b>Tương đối</b> (<tt>nhãn</tt>): Nhánh sử dụng độ lệch 8 bit đã ký từ lệnh tiếp theo (−128…+127)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>S</b> or Down Arrow key (<tt>$73</tt>)"
msgstr "<b>S</b> hoặc phím Mũi tên xuống (<tt>$73</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>SBC needs carry set</b>: Set <tt>C</tt> before subtracting (works as inverse borrow). <tt>C</tt> clear after SBC indicates a borrow occurred."
msgstr "<b>SBC cần tập nhớ</b>: Đặt <tt>C</tt> trước khi trừ (hoạt động như mượn nghịch đảo). <tt>C</tt> xóa sau khi SBC cho biết đã xảy ra khoản vay."

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>SP</b> (Stack Pointer): Points to current stack position (starts at <tt>$FF</tt>)"
msgstr "<b>SP</b> (Con trỏ ngăn xếp): Trỏ đến vị trí ngăn xếp hiện tại (bắt đầu tại <tt>$FF</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>STA/STX/STY</b>: Store registers to memory"
msgstr "<b>STA/STX/STY</b>: Lưu trữ các thanh ghi vào bộ nhớ"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Stack</b>: <tt>$0100</tt>-<tt>$01FF</tt>"
msgstr "<b>Ngăn xếp</b>: <tt>$0100</tt>-<tt>$01FF</tt>"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>V</b> (Overflow): Set when arithmetic operation causes signed overflow"
msgstr "<b>V</b> (Tràn): Đặt khi phép tính số học gây ra tràn có dấu"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>W</b> or Up Arrow key (<tt>$77</tt>)"
msgstr "<b>W</b> hoặc Phím mũi tên lên (<tt>$77</tt>)"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>X, Y</b>: Index registers for addressing and counting"
msgstr "<b>X, Y</b>: Thanh ghi chỉ mục để đánh địa chỉ và đếm"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Z</b> (Zero): Set when result is zero"
msgstr "<b>Z</b> (Không): Đặt khi kết quả bằng 0"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Zero Page,X/Y</b> (<tt>$c0,X</tt>): Add X/Y register to zero page address"
msgstr "<b>Trang Không,X/Y</b> (<tt>$c0,X</tt>): Thêm thanh ghi X/Y vào địa chỉ trang 0"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Zero Page</b> (<tt>$c0</tt>): Access memory locations <tt>$00</tt>-<tt>$FF</tt>"
msgstr "<b>Trang Không</b> (<tt>$c0</tt>): Truy cập các vị trí bộ nhớ <tt>$00</tt>-<tt>$FF</tt>"

#. TRANSLATORS: MDX-derived text from packages/learn/quick-help.mdx
msgid "<b>Zero Page</b>: <tt>$0000</tt>-<tt>$00FF</tt> (first 256 bytes, faster access)"
msgstr "<b>Trang Không</b>: <tt>$0000</tt>-<tt>$00FF</tt> (256 byte đầu tiên, truy cập nhanh hơn)"

#. TRANSLATORS: MDX-derived text from packages/learn/tutorial.mdx
msgid "<tt>BCC</tt> and <tt>BCS</tt> (\"branch on carry clear\" and \"branch on carry set\") are used to branch on the carry flag. Write a program that uses one of these two."
msgstr "<tt>BCC</tt> và <tt>BCS</tt> (\"rẽ nhánh khi cờ nhớ xóa\" và \"rẽ nhánh khi cờ nhớ đặt\") được sử dụng để rẽ nhánh dựa trên cờ nhớ. Viết chương trình sử dụng một trong hai."

#. TRANSLATORS: MDX-derived text from packages/learn/tutorial.mdx
msgid "<tt>JMP</tt> is an unconditional jump. Here's a really simple example to show it in action:"
msgstr "<tt>JMP</tt> là bước nhảy không điều kiện. Đây là một ví dụ thực sự đơn giản để hiển thị nó trong thực tế:"

#. TRANSLATORS: MDX-derived text from packages/learn/tutorial.mdx
msgid "<tt>JSR</tt> and <tt>RTS</tt> (\"jump to subroutine\" and \"return from subroutine\") are a dynamic duo that you'll usually see used together. <tt>JSR</tt> is used to jump from the current location to another part of the code. <tt>RTS</tt> returns to the previous position. This is basically like calling a function and returning."
msgstr "<tt>JSR</tt> và <tt>RTS</tt> (\"chuyển tới chương trình con\" và \"trở về từ chương trình con\") là một bộ đôi năng động mà bạn thường thấy được sử dụng cùng nhau. <tt>JSR</tt> được sử dụng để chuyển từ vị trí hiện tại sang phần khác của mã. <tt>RTS</tt> trở về vị trí trước đó. Về cơ bản, điều này giống như gọi một hàm và trả về."

#. TRANSLATORS: MDX-derived text from packages/learn/tutorial.mdx
msgid "<tt>PC</tt> is the program counter - it's how the processor knows at what point in the program it currently is. It's like the current line number of an executing script. In the simulator the code is assembled starting at memory location <tt>$0600</tt>, so <tt>PC</tt> always starts there."
msgstr "<tt>PC</tt> là bộ đếm chương trình - đó là cách bộ xử lý biết nó hiện đang ở điểm nào trong chương trình. Nó giống như số dòng hiện tại của tập lệnh thực thi. Trong trình mô phỏng, mã được tập hợp bắt đầu từ vị trí bộ nhớ <tt>$0600</tt>, vì vậy <tt>PC</tt> luôn bắt đầu ở đó."

#. TRANSLATORS: MDX-derived text from packages/learn/tutorial.mdx
msgid "<tt>SP</tt> is the stack pointer. I won't get into the stack yet, but basically this register is decremented every time a byte is pushed onto the stack, and incremented when a byte is popped off the stack."
msgstr "<tt>SP</tt> là con trỏ ngăn xếp. Tôi chưa vào ngăn xếp, nhưng về cơ bản, thanh ghi này sẽ giảm đi mỗi khi một byte được đẩy lên ngăn xếp và tăng lên khi một byte được lấy ra khỏi ngăn xếp."

#. TRANSLATORS: MDX-derived text from packages/learn/tutorial.mdx
msgid "<tt>X</tt> holds the pixel colour, and <tt>Y</tt> holds the position of the current pixel. The first loop draws the current colour as a pixel (via the <tt>A</tt> register), pushes the colour to the stack, then increments the colour and position. The second loop pops the stack, draws the popped colour as a pixel, then increments the position. As should be expected, this creates a mirrored pattern."
msgstr "<tt>X</tt> giữ màu pixel và <tt>Y</tt> giữ vị trí của pixel hiện tại. Vòng lặp đầu tiên vẽ màu hiện tại dưới dạng pixel (thông qua thanh ghi <tt>A</tt>), đẩy màu vào ngăn xếp, sau đó tăng màu và vị trí. Vòng lặp thứ hai sẽ bật ngăn xếp, vẽ màu được bật lên dưới dạng pixel, sau đó tăng vị trí. Đúng như mong đợi, điều này tạo ra một mô hình được phản chiếu."

#. TRANSLATORS: MDX-derived text from packages/learn/tutorial.mdx
msgid "<tt>a9</tt> and <tt>c9</tt> are the processor opcodes for immediate-addressed <tt>LDA</tt> and <tt>CMP</tt> respectively. <tt>01</tt> and <tt>02</tt> are the arguments to these instructions. <tt>d0</tt> is the opcode for <tt>BNE</tt>, and its argument is <tt>02</tt>. This means \"skip over the next two bytes\" (<tt>85 22</tt>, the assembled version of <tt>STA $22</tt>). Try editing the code so <tt>STA</tt> takes a two-byte absolute address rather than a single-byte zero page address (e.g. change <tt>STA $22</tt> to <tt>STA $2222</tt>). Reassemble the code and look at the hexdump again - the argument to <tt>BNE</tt> should now be <tt>03</tt>, because the instruction the processor is skipping past is now three bytes long."
msgstr "<tt>a9</tt> và <tt>c9</tt> lần lượt là các mã bộ xử lý dành cho <tt>LDA</tt> và <tt>CMP</tt> có địa chỉ tức thời. <tt>01</tt> và <tt>02</tt> là đối số của các hướng dẫn này. <tt>d0</tt> là mã hoạt động cho <tt>BNE</tt> và đối số của nó là <tt>02</tt>. Điều này có nghĩa là \"bỏ qua hai byte tiếp theo\" (<tt>85 22</tt>, phiên bản tập hợp của <tt>STA $22</tt>). Hãy thử chỉnh sửa mã để <tt>STA</tt> lấy địa chỉ tuyệt đối 2 byte thay vì địa chỉ trang không byte đơn (ví dụ: thay đổi <tt>STA $22</tt> thành <tt>STA $2222</tt>). Tập hợp lại mã và xem lại kết xuất hex - đối số của <tt>BNE</tt> bây giờ phải là <tt>03</tt>, vì lệnh mà bộ xử lý bỏ qua hiện dài 3 byte."

#. TRANSLATORS: MDX-derived text from packages/learn/tutorial.mdx
msgid "<tt>checkSnakeCollision</tt> loops through the snake's body segments, checking each byte pair against the head pair. If there is a match, then game over."
msgstr "<tt>checkSnakeCollision</tt> lặp qua các đoạn cơ thể của con rắn, kiểm tra từng cặp byte so với cặp đầu. Nếu có sự trùng khớp thì trò chơi kết thúc."

#. TRANSLATORS: MDX-derived text from packages/learn/tutorial.mdx
msgid "<tt>init</tt> and <tt>loop</tt> are both subroutines. <tt>init</tt> initializes the game state, and <tt>loop</tt> is the main game loop."
msgstr "<tt>init</tt> và <tt>loop</tt> đều là chương trình con. <tt>init</tt> khởi tạo trạng thái trò chơi và <tt>loop</tt> là vòng lặp trò chơi chính."

