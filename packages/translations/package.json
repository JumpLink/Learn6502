    "clear": "rm -rf dist"
  },
  "devDependencies": {
    "@gjsify/vite-plugin-gettext": "^0.10.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@learn6502/learn": "^0.7.0"
  }
}
