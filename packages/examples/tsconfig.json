{
  "compilerOptions": {
    "preserveWatchOutput": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "nano-jsx/esm",
    "types": ["mdx", "node"],
    "diagnostics": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["env.d.ts", "**/*.mdx", "**/*.ts", "**/*.tsx"]
}
