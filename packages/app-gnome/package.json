{
  "name": "@learn6502/app-gnome",
  "version": "0.3.0",
  "description": "Learn 6502 assembly by developing games on a virtual console",
  "main": "dist/main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clear": "yarn clear:dist && yarn clear:resources && yarn clear:settings",
    "clear:dist": "rm -rf dist",
    "clear:resources": "rm -rf data/eu.jumplink.Learn6502.data.gresource",
    "clear:settings": "GSETTINGS_SCHEMA_DIR=$PWD/data/schemas gsettings reset-recursively eu.jumplink.Learn6502",
    "build:vite": "vite build",
    "build:resources": "glib-compile-resources --sourcedir data data/eu.jumplink.Learn6502.data.gresource.xml",
    "build:schema": "mkdir -p data/schemas && glib-compile-schemas --strict --targetdir=data/schemas data",
    "build:with-deps": "yarn workspaces foreach -pRv --from @learn6502/app-gnome --topological-dev run build",
    "build": "yarn build:vite && yarn build:resources && yarn build:schema",
    "check": "yarn check:typescript && yarn check:metainfo",
    "check:typescript": "tsc",
    "start:app": "GSETTINGS_SCHEMA_DIR=$PWD/data/schemas gjs -m eu.jumplink.Learn6502",
    "debug:app": "GTK_DEBUG=interactive GSETTINGS_SCHEMA_DIR=$PWD/data/schemas gjs -m eu.jumplink.Learn6502",
    "start": "yarn start:app",
    "check:metainfo": "flatpak run --command=flatpak-builder-lint org.flatpak.Builder appstream data/metainfo/eu.jumplink.Learn6502.metainfo.xml"
  },
  "author": "Pascal Garber <pascal@mailfreun.de>",
  "license": "GPL-3.0",
  "devDependencies": {
    "@gjsify/vite-plugin-blueprint": "^0.2.9",
    "@gjsify/vite-plugin-gettext": "^0.2.9",
    "lightningcss": "^1.30.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-plugin-static-copy": "^3.1.2"
  },
  "dependencies": {
    "@girs/adw-1": "^1.9.0-4.0.0-beta.38",
    "@girs/gdk-4.0": "^4.0.0-4.0.0-beta.38",
    "@girs/gdkpixbuf-2.0": "^2.0.0-4.0.0-beta.38",
    "@girs/gio-2.0": "^2.86.0-4.0.0-beta.38",
    "@girs/gjs": "^4.0.0-beta.38",
    "@girs/glib-2.0": "^2.86.0-4.0.0-beta.38",
    "@girs/gobject-2.0": "^2.86.0-4.0.0-beta.38",
    "@girs/gtk-4.0": "^4.20.1-4.0.0-beta.38",
    "@girs/gtksource-5": "^5.18.0-4.0.0-beta.38",
    "@girs/javascriptcore-6.0": "^2.50.0-4.0.0-beta.38",
    "@girs/pango-1.0": "^1.57.0-4.0.0-beta.38",
    "@girs/webkit-6.0": "^2.50.0-4.0.0-beta.38",
    "@learn6502/6502": "workspace:^",
    "@learn6502/common-ui": "workspace:^",
    "@learn6502/learn": "workspace:^",
    "@learn6502/translations": "workspace:^"
  }
}
