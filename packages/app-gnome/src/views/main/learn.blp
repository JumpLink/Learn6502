using Gtk 4.0;
using Adw 1;

template $Learn: Adw.Bin {
  height-request: 200;
  vexpand: true;
  Adw.StatusPage statusPage {
    // TRANSLATORS: Card title for Learn/Tutorial view
    title: _("Learn");
    // TRANSLATORS: Short description of the Learn view
    description: _("Learn how to program the 6502 microprocessor.");
    icon-name: "school-symbolic";
    Adw.Clamp {
      maximum-size: 600;
      margin-top: 0;
      margin-bottom: 0;
      margin-start: 0;
      margin-end: 0;

      child: $TutorialView tutorialView {};
    }
  }
}
