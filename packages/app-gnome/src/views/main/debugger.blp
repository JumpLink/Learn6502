using Gtk 4.0;
using Adw 1;

template $Debugger: Adw.Bin {

  ScrolledWindow {
    hexpand: true;
    vexpand: true;
    hscrollbar-policy: never;
    vscrollbar-policy: automatic;

    Stack stack {
      
      StackPage {
        name: "debugger";
        child: Adw.Clamp {

          maximum-size: 600;
          margin-top: 12;
          margin-bottom: 12;
          margin-start: 12;
          margin-end: 12;

          child: Box {
            orientation: vertical;

            Adw.PreferencesGroup {
              // TRANSLATORS: Debugger page settings group title
              title: _("Settings");
              margin-bottom: 12;

              Adw.SwitchRow enabledSwitch {
                // TRANSLATORS: Preference switch label on Debugger page to enable/disable the debugger
                title: _("Enable Debugger");
                // TRANSLATORS: Switch subtitle explaining performance impact of debugger
                subtitle: _("Disable to improve performance");
                active: bind template.enabled bidirectional;
              }

              Adw.SwitchRow stepperSwitch {
                // TRANSLATORS: Preference switch label to enable step-by-step execution
                title: _("Enable Stepper Mode");
                // TRANSLATORS: Switch subtitle describing stepper mode behavior
                subtitle: _("Execute instructions one by one instead of continuously");
                sensitive: bind template.enabled;
              }
            }

            // Information
            Box debugInfoBox {
              sensitive: bind template.enabled;
              margin-bottom: 12;
              $DebugInfo debugInfo {}
            }

            // Hex Monitor
            Label {
              sensitive: bind template.enabled;
              // TRANSLATORS: Section heading label for the Hex Monitor block
              label: _("Hex Monitor");
              halign: start;
              margin-bottom: 12;
              margin-top: 12;
              styles [
                "heading"
              ]
            }
            Frame {
              sensitive: bind template.enabled;
              margin-bottom: 12;
              $HexMonitor hexMonitor {}
            }

            // Hexdump
            Label {
              sensitive: bind template.enabled;
              // TRANSLATORS: Section heading label for the Hexdump block
              label: _("Hexdump");
              halign: start;
              margin-bottom: 12;
              margin-top: 12;
              styles [
                "heading"
              ]
            }
            Frame {
              sensitive: bind template.enabled;
              margin-bottom: 12;
              $Hexdump hexdump {}
            }

            // Disassembled
            Label {
              sensitive: bind template.enabled;
              // TRANSLATORS: Section heading label for the disassembled instructions block
              label: _("Disassembled");
              halign: start;
              margin-bottom: 12;
              margin-top: 12;
              styles [
                "heading"
              ]
            }
            Frame {
              sensitive: bind template.enabled;
              margin-bottom: 12;
              $Disassembled disassembled {}
            }

            // Messages
            Label {
              sensitive: bind template.enabled;
              // TRANSLATORS: Section heading label for console messages block
              label: _("Messages");
              halign: start;
              margin-bottom: 12;
              margin-top: 12;
              styles [
                "heading"
              ]
            }
            Frame {
              sensitive: bind template.enabled;
              margin-bottom: 12;
              $MessageConsole messageConsole {}
            }
          };
        };
      }
    }
  }
}
