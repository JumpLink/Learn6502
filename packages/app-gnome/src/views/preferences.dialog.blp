using Gtk 4.0;
using Adw 1;
// This template is based on a Workbench example and just a example of how to use the Adw.PreferencesDialog
template $PreferencesDialog: Adw.PreferencesDialog {
  content-width: 800;
  content-height: 600;
  title: _("Appearance");

  Adw.PreferencesPage appearancePage {
    css-classes: ["appearance-page"];
    title: _("Appearance");
    icon-name: "brush-monitor-symbolic";

    Adw.PreferencesGroup themeGroup {
      title: _("Style");

      $ThemeModeSelector {
        css-classes: ["card", "theme-mode-selector"];
      }
    }

    Adw.PreferencesGroup primaryGroup {
      css-classes: ["custom-color-group"];
      title: _("Primary color");

      Adw.SwitchRow rowPrimary {
        title: _("Use custom primary color");
        // TS syncs on map; default off to avoid early notify loops
        active: false;
      }

      $PrimaryColorSelector {
        css-classes: ["card", "rounded-t-none", "primary-color-selector"];
        enabled: bind rowPrimary.active;
      }
    }

    Adw.PreferencesGroup accentGroup {
      css-classes: ["custom-color-group"];
      title: _("Accent color");

      Adw.SwitchRow rowAccent {
        title: _("Use custom accent color");
        // TS syncs on map; default off to avoid early notify loops
        active: false;
      }

      $AccentColorSelector {
        css-classes: ["card", "rounded-t-none", "accent-color-selector"];
        enabled: bind rowAccent.active;
      }
    }
  }
}
