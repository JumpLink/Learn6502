using Gtk 4.0;
using Adw 1;

template $MainWindow: Adw.ApplicationWindow {
  name: "application-window";
  default-width: 360;
  default-height: 670;
  width-request: 360;
  height-request: 624;

  // Auto switch between single and three-column layouts
  [breakpoint]
  Adw.Breakpoint {
    condition ("min-width: 1200sp and min-height: 800sp")

    setters {
      layoutHost.visible-child-name: "three";
      switcherBar.reveal: false;
      leftCenterPaned.position: 360;

      titleLabel.visible: true;
      mainButton.visible: false;
      runToolbar.visible: true;
    }
  }

  [breakpoint]
  Adw.Breakpoint {
    condition ("max-width: 1199sp or max-height: 799sp")

    setters {
      layoutHost.visible-child-name: "single";
      switcherBar.reveal: true;

      titleLabel.visible: false;
      mainButton.visible: true;
      runToolbar.visible: false;
    }
  }

  // Very wide desktop: increase left column width
  [breakpoint]
  Adw.Breakpoint {
    condition ("min-width: 1600sp and min-height: 800sp")

    setters {
      layoutHost.visible-child-name: "three";
      switcherBar.reveal: false;
      leftCenterPaned.position: 600;

      titleLabel.visible: true;
      mainButton.visible: false;
      runToolbar.visible: true;
    }
  }

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar headerBar {

      title-widget: Label titleLabel {
        label: _("Learn 6502 Assembly");
      };

      [start]
      

      Button unsavedChangesIndicator {
        icon-name: "dot-symbolic";
        tooltip-text: _("Unsaved changes");
        visible: false;
        styles [
          "flat",
          "circular"
        ]
      }
      [end]
      $MenuButton menuButton {
        halign: center;
      }

    }

    content: Overlay mainOverlay {
      child: Adw.ToastOverlay toastOverlay {
        Stack layoutHost {
          name: "layoutHost";

          // Single (mobile) layout: one ViewStack
          StackPage singlePage {
            name: "single";
            child: Adw.Bin singleContainer {
              child: Adw.ViewStack stack {
                vexpand: true;
              };
            };
          }

          // Three column (desktop) layout: Learn | Editor | (GameConsole over Debugger)
          StackPage threePage {
            name: "three";
            child: Adw.Bin threeColumnContainer {
              child: Box threeColumns {
                orientation: horizontal;
                spacing: 0;

                // Paned splits left (Learn) and center+right
                Gtk.Paned leftCenterPaned {
                  orientation: horizontal;
                  resize-start-child: false;
                  shrink-start-child: false;
                  resize-end-child: true;
                  shrink-end-child: true;

                  start-child: Box leftColumn {
                    hexpand: false;
                    vexpand: true;
                  };

                  end-child: Box centerRight {
                    orientation: horizontal;
                    hexpand: true;
                    vexpand: true;

                    // Center column (Editor)
                    Box centerColumn {
                      hexpand: true;
                      vexpand: true;
                    }

                    Separator {}

                    // Right column with two rows (GameConsole top, Debugger bottom)
                    Box rightColumn {
                      orientation: vertical;
                      hexpand: false;
                      vexpand: true;

                      Box rightTopBox {
                        hexpand: false;
                        vexpand: false;
                        margin-bottom: 0;
                        margin-start: 12;
                        margin-end: 12;
                        margin-top: 0;
                      }

                      Separator {}

                      Box rightBottomBox {
                        hexpand: true;
                        vexpand: true;
                      }
                    }
                  };
                }
              };
            };
          }
        }
      };

      [overlay]
      $MainButton mainButton {
        halign: end;
        valign: end;
        margin-end: 0;
        margin-bottom: 0;
      }

      [overlay]
      $Toolbar runToolbar {
        halign: end;
        valign: center;
        margin-end: 360;
      }
    };

    [bottom]
    Adw.ViewSwitcherBar switcherBar {
      reveal: true;
    }

  };
}

// Dialog for unsaved changes
Adw.AlertDialog unsavedChangesDialog {
  heading: _("Save changes?");
  body: _("Your file has unsaved changes. Changes will be lost if you don't save them.");
  close-response: "cancel";

  responses [
    cancel: _("Cancel"),
    discard: _("Discard") destructive,
    save: _("Save") suggested,
  ]
}

// Feature views instantiated as internal children of the template
$Learn learn {}
$Editor editor {}
$Debugger debugger {}
$GameConsole gameConsole {}
