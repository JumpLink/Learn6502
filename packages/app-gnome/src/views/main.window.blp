using Gtk 4.0;
using Adw 1;

template $MainWindow: Adw.ApplicationWindow {
  name: "application-window";
  default-width: 360;
  default-height: 670;
  width-request: 360;
  height-request: 624;

  // Add breakpoint for responsive design
  [breakpoint]
  Adw.Breakpoint {
    condition ("max-width: 500sp")

    setters {
      titleLabel.visible: false;
    }
  }

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar headerBar {

      title-widget: Label titleLabel {
        label: _("Learn 6502 Assembly");
      };

      [start]
      

      Button unsavedChangesIndicator {
        icon-name: "dot-symbolic";
        tooltip-text: _("Unsaved changes");
        visible: false;
        styles [
          "flat",
          "circular"
        ]
      }
      [end]
      $RunMenuButton menuButton {
        halign: center;
      }

    }

    content: Overlay mainOverlay {
      child: Adw.ToastOverlay toastOverlay {
        Adw.ViewStack stack {
          vexpand: true;

          Adw.ViewStackPage {
            name: "learn";
            title: _("Learn");
            icon-name: "school-symbolic";
            use-underline: true;

            child: $Learn learn {};
          }

          Adw.ViewStackPage {
            name: "editor";
            title: _("Editor");
            icon-name: "code-symbolic";
            use-underline: true;

            child: $Editor editor {};
          }

          Adw.ViewStackPage {
            name: "debugger";
            title: _("Debugger");
            icon-name: "bug-symbolic";
            use-underline: true;

            child: $Debugger debugger {};
          }

          Adw.ViewStackPage {
            name: "gameConsole";
            title: _("Game Console");
            icon-name: "nintendo-controller-symbolic";
            use-underline: true;

            child: $GameConsole gameConsole {};
          }
        }
      };

      [overlay]
      $MainButton mainButton {
        halign: end;
        valign: end;
        margin-end: 0;
        margin-bottom: 0;
      }
    };

    [bottom]
    Adw.ViewSwitcherBar switcherBar {
      stack: stack;
      reveal: true;
    }

  };
}

// Dialog for unsaved changes
Adw.AlertDialog unsavedChangesDialog {
  heading: _("Save changes?");
  body: _("Your file has unsaved changes. Changes will be lost if you don't save them.");
  close-response: "cancel";

  responses [
    cancel: _("Cancel"),
    discard: _("Discard") destructive,
    save: _("Save") suggested,
  ]
}
