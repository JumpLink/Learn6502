using Gtk 4.0;
using Adw 1;

template $MainButton : Adw.Bin {
  // Adw.SplitButton button {
  //   halign: center;
  //   menu-model: buttonRunMenu;
  //   styles [
  //     "circular",
  //     "suggested-action",
  //   ]
  // }

  // TODO: With revealer we can remove / show the button with animation
  Gtk.Revealer revealer {
    transition-type: slide_up;
    reveal-child: true;
    child: Gtk.Button button {
      vexpand: true;
      hexpand: true;
      halign: center;
      styles [
        "circular",
        "suggested-action",
        "main-button-fab",
      ]
    };
  }
}

