using Gtk 4.0;
using Adw 1;

template $MainButton  : Adw.Bin {
  name: "main-button";
  Gtk.Revealer revealer {
    transition-type: slide_up;
    reveal-child: true;
    vexpand: true;
    valign: end;
    margin-end: 0;
    margin-bottom: 0;
    child: Gtk.Button button {
      vexpand: true;
      hexpand: true;
      halign: center;
      styles [
        "suggested-action"
      ]
    };
  }
}
