using Gtk 4.0;
using Adw 1;

template $MainButton  : Adw.Bin {
  name: "main-button";
  Gtk.Revealer revealer {
    transition-type: slide_up;
    reveal-child: true;
    vexpand: true;
    valign: end;
    // Logical margin so the FAB keeps its edge spacing in RTL too (end = right
    // in LTR, left in RTL). A physical CSS padding-right does not mirror.
    margin-end: 16;
    margin-bottom: 0;
    child: Gtk.Button button {
      vexpand: true;
      hexpand: true;
      halign: center;
      styles [
        "suggested-action"
      ]
    };
  }
}
