// Adapted from https://github.com/sonnyp/troll/blob/8b0275948eedec9ed0378f9bdda1aa4aac3062ba/src/widgets/README.md
using Gtk 4.0;
using Adw 1;

template $ThemeSelector : Adw.Bin {
  hexpand: true;

  Box box {
    hexpand: true;
    orientation: horizontal;
    spacing: 12;

    CheckButton follow {
      styles [
        "theme-selector",
        "follow",
      ]

      hexpand: true;
      halign: center;
      focus-on-click: false;
      tooltip-text: _("Follow system style");
      toggled => $_onFollowToggled();

      accessibility {
        label: _("Follow system style");
      }
    }

    CheckButton light {
      styles [
        "theme-selector",
        "light",
      ]

      hexpand: true;
      halign: center;
      focus-on-click: false;
      tooltip-text: _("Light style");
      toggled => $_onLightToggled();

      accessibility {
        label: _("Light style");
      }
    }

    CheckButton dark {
      styles [
        "theme-selector",
        "dark",
      ]

      hexpand: true;
      halign: center;
      group: light;
      focus-on-click: false;
      tooltip-text: _("Dark style");
      toggled => $_onDarkToggled();

      accessibility {
        label: _("Dark style");
      }
    }
  }
}

