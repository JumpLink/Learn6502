// Adapted from https://github.com/sonnyp/troll/blob/8b0275948eedec9ed0378f9bdda1aa4aac3062ba/src/widgets/README.md
using Gtk 4.0;
using Adw 1;

template $ThemeSelector : Adw.Bin {
  hexpand: true;

  Box root {
    hexpand: true;
    orientation: vertical;
    spacing: 6;

    Box box {
      hexpand: true;
      orientation: horizontal;
      spacing: 12;

      CheckButton follow {
      styles [
        "theme-selector",
        "follow",
      ]

      hexpand: true;
      halign: center;
      focus-on-click: false;
      tooltip-text: _("Follow system style");
      toggled => $_onFollowToggled();

      accessibility {
        label: _("Follow system style");
      }
    }

      CheckButton light {
      styles [
        "theme-selector",
        "light",
      ]

      hexpand: true;
      halign: center;
      focus-on-click: false;
      tooltip-text: _("Light style");
      toggled => $_onLightToggled();

      accessibility {
        label: _("Light style");
      }
    }

      CheckButton dark {
      styles [
        "theme-selector",
        "dark",
      ]

      hexpand: true;
      halign: center;
      group: light;
      focus-on-click: false;
      tooltip-text: _("Dark style");
      toggled => $_onDarkToggled();

      accessibility {
        label: _("Dark style");
      }
    }
  }

  /* Primary color selector row */
    Box accents {
    margin-top: 6;
    hexpand: true;
    orientation: horizontal;
    spacing: 8;

    CheckButton primary_auto {
      styles [ "theme-selector", "primary", "primary-auto" ]
      focus-on-click: false;
      tooltip-text: _("Follow system primary");
      toggled => $_onPrimaryAutoToggled();
      accessibility { label: _("Follow system primary"); }
    }

    CheckButton primary_none {
      styles [ "theme-selector", "primary", "primary-none" ]
      focus-on-click: false;
      tooltip-text: _("No primary override");
      toggled => $_onPrimaryNoneToggled();
      accessibility { label: _("No primary override"); }
    }

    CheckButton primary_blue {
      styles [ "theme-selector", "primary", "primary-blue" ]
      focus-on-click: false;
      tooltip-text: _("Primary: Blue");
      toggled => $_onPrimaryBlueToggled();
      accessibility { label: _("Primary: Blue"); }
    }

    CheckButton primary_teal {
      styles [ "theme-selector", "primary", "primary-teal" ]
      focus-on-click: false;
      tooltip-text: _("Primary: Teal");
      toggled => $_onPrimaryTealToggled();
      accessibility { label: _("Primary: Teal"); }
    }

    CheckButton primary_green {
      styles [ "theme-selector", "primary", "primary-green" ]
      focus-on-click: false;
      tooltip-text: _("Primary: Green");
      toggled => $_onPrimaryGreenToggled();
      accessibility { label: _("Primary: Green"); }
    }

    CheckButton primary_yellow {
      styles [ "theme-selector", "primary", "primary-yellow" ]
      focus-on-click: false;
      tooltip-text: _("Primary: Yellow");
      toggled => $_onPrimaryYellowToggled();
      accessibility { label: _("Primary: Yellow"); }
    }

    CheckButton primary_orange {
      styles [ "theme-selector", "primary", "primary-orange" ]
      focus-on-click: false;
      tooltip-text: _("Primary: Orange");
      toggled => $_onPrimaryOrangeToggled();
      accessibility { label: _("Primary: Orange"); }
    }

    CheckButton primary_red {
      styles [ "theme-selector", "primary", "primary-red" ]
      focus-on-click: false;
      tooltip-text: _("Primary: Red");
      toggled => $_onPrimaryRedToggled();
      accessibility { label: _("Primary: Red"); }
    }

    CheckButton primary_pink {
      styles [ "theme-selector", "primary", "primary-pink" ]
      focus-on-click: false;
      tooltip-text: _("Primary: Pink");
      toggled => $_onPrimaryPinkToggled();
      accessibility { label: _("Primary: Pink"); }
    }

    CheckButton primary_purple {
      styles [ "theme-selector", "primary", "primary-purple" ]
      focus-on-click: false;
      tooltip-text: _("Primary: Purple");
      toggled => $_onPrimaryPurpleToggled();
      accessibility { label: _("Primary: Purple"); }
    }

    CheckButton primary_slate {
      styles [ "theme-selector", "primary", "primary-slate" ]
      focus-on-click: false;
      tooltip-text: _("Primary: Slate");
      toggled => $_onPrimarySlateToggled();
      accessibility { label: _("Primary: Slate"); }
    }
    }
  }
}

