using Gtk 4.0;
using Adw 1;

template $MessageConsole: Adw.Bin {
  ScrolledWindow scrolledWindow {
    height-request: 200;
    vexpand: true;
    has-frame: false;
    // Messages wrap instead of scrolling horizontally; a horizontal
    // scrollbar would not mirror well in RTL locales (see issue #129)
    hscrollbar-policy: never;
    TextView textView {
      editable: false;
      hexpand: true;
      hexpand-set: true;
      wrap-mode: word_char;
      bottom-margin: 12;
      left-margin: 12;
      right-margin: 12;
      top-margin: 12;
    }
  }
}
