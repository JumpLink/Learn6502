using Gtk 4.0;
using Adw 1;

template $HexMonitor: Adw.Bin {
  Box {
    orientation: vertical;
    spacing: 8;

    Box {
      spacing: 8;
      margin-start: 8;
      margin-end: 8;
      margin-top: 8;

      DropDown memoryRegionDropDown {
        enable-search: false;
        model: StringList {
          strings [
            // TRANSLATORS: Dropdown option label for zero-page memory range
            _("Zero Page ($0000-$00FF)"),
            // TRANSLATORS: Dropdown option label for stack memory range
            _("Stack ($0100-$01FF)"),
            // TRANSLATORS: Dropdown option label for display memory range
            _("Display Memory ($0200-$05FF)"),
            // TRANSLATORS: Dropdown option label for program storage range
            _("Program Storage ($0600-$FFFF)"),
            // TRANSLATORS: Dropdown option label for tutorial-specific snake game data range
            _("Snake Game Data ($00-$15)"),
            // TRANSLATORS: Dropdown option label for random/input IO range
            _("Random/Input ($FE-$FF)"),
            // TRANSLATORS: Dropdown option label for full memory range
            _("Full Memory ($0000-$FFFF)")
          ]
        };
      }
    }

    $SourceView sourceView {
      editable: false;
      copyable: true;
      copy-button-icon: 'clipboard-symbolic';
      // TRANSLATORS: Tooltip for button that copies the hex monitor content to clipboard
      copy-button-tooltip: _("Copy to clipboard");
      language: 'hex';
      vexpand: true;
      hexpand: false;
      line-numbers: true;
      height: 360;
    }
  }
}
