using Gtk 4.0;
using Adw 1;

template $DebugInfo: Adw.Bin {
  hexpand: true;
  vexpand: true;

  Gtk.Box mainBox {
    orientation: vertical;

    // ===== REGISTERS =====
    Adw.PreferencesGroup grpRegisters {
      title: "Registers";
      margin-bottom: 12;

      Adw.ActionRow rowA {
        title: "A";
        subtitle: "";

        [suffix]
        Gtk.Label aValue {
          hexpand: true;
          halign: end;
          selectable: true;
          css-classes: ["monospace"];
          label: "0x00";
        }
      }

      Adw.ActionRow rowX {
        title: "X";
        subtitle: "";

        [suffix]
        Gtk.Label xValue {
          hexpand: true;
          halign: end;
          selectable: true;
          css-classes: ["monospace"];
          label: "0x00";
        }
      }

      Adw.ActionRow rowY {
        title: "Y";
        subtitle: "";

        [suffix]
        Gtk.Label yValue {
          hexpand: true;
          halign: end;
          selectable: true;
          css-classes: ["monospace"];
          label: "0x00";
        }
      }

      Adw.ActionRow rowSP {
        title: "SP";

        [suffix]
        Gtk.Label spValue {
          hexpand: true;
          halign: end;
          selectable: true;
          css-classes: ["monospace"];
          label: "0xff";
        }
      }

      Adw.ActionRow rowPC {
        title: "PC";
        subtitle: "Next instruction address";

        [suffix]
        Gtk.Label pcValue {
          hexpand: true;
          halign: end;
          selectable: true;
          css-classes: ["monospace"];
          label: "0x0600";
        }
      }
    }

    // ===== FLAGS =====
    Adw.PreferencesGroup grpFlags {
      title: "Status Flags";

      Adw.ActionRow rowStatus {
        title: "P (SR)";
        subtitle: "NV-BDIZC · Processor Status";

        [suffix]
        Gtk.Grid statusGrid {
          halign: end;
          margin-bottom: 12;
          margin-top: 12;
          row-spacing: 2;
          column-spacing: 6;
          column-homogeneous: true;

          // Kopfzeile: N V - B D I Z C
          Gtk.Label nHdr {
            label: "N";
            css-classes: ["flag"];
            layout { row: 0; column: 0; }
          }
          Gtk.Label vHdr {
            label: "V";
            css-classes: ["flag"];
            layout { row: 0; column: 1; }
          }
          Gtk.Label dashHdr {
            label: "-";
            css-classes: ["flag", "dim-label"];
            layout { row: 0; column: 2; }
          }
          Gtk.Label bHdr {
            label: "B";
            css-classes: ["flag"];
            layout { row: 0; column: 3; }
          }
          Gtk.Label dHdr {
            label: "D";
            css-classes: ["flag"];
            layout { row: 0; column: 4; }
          }
          Gtk.Label iHdr {
            label: "I";
            css-classes: ["flag"];
            layout { row: 0; column: 5; }
          }
          Gtk.Label zHdr {
            label: "Z";
            css-classes: ["flag"];
            layout { row: 0; column: 6; }
          }
          Gtk.Label cHdr {
            label: "C";
            css-classes: ["flag"];
            layout { row: 0; column: 7; }
          }

          // Bitzeile: p7..p0 (MSB..LSB)
          Gtk.Label p7 {
            label: "0";
            css-classes: ["monospace", "bit"];
            layout { row: 1; column: 0; }
          }
          Gtk.Label p6 {
            label: "0";
            css-classes: ["monospace", "bit"];
            layout { row: 1; column: 1; }
          }
          Gtk.Label p5 {
            label: "0";
            css-classes: ["monospace", "bit", "dim-label"];
            layout { row: 1; column: 2; }
          }
          Gtk.Label p4 {
            label: "0";
            css-classes: ["monospace", "bit", "dim-label"];
            layout { row: 1; column: 3; }
          }
          Gtk.Label p3 {
            label: "1";
            css-classes: ["monospace", "bit"];
            layout { row: 1; column: 4; }
          }
          Gtk.Label p2 {
            label: "1";
            css-classes: ["monospace", "bit"];
            layout { row: 1; column: 5; }
          }
          Gtk.Label p1 {
            label: "0";
            css-classes: ["monospace", "bit", "dim-label"];
            layout { row: 1; column: 6; }
          }
          Gtk.Label p0 {
            label: "0";
            css-classes: ["monospace", "bit", "dim-label"];
            layout { row: 1; column: 7; }
          }
        }
      }
    }
  }
}