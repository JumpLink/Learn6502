{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["@gjsify/rolldown-plugin-gjsify/types"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "diagnostics": true
  },
  "files": [
    "src/app/main.ts",
    "src/types/html-module.d.ts",
    "src/types/asm-module.d.ts",
    "src/types/css.d.ts",
    "src/types/svg-module.d.ts",
    "src/types/version.d.ts"
  ]
}
