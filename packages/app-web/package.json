{
  "name": "@learn6502/app-web",
  "version": "0.7.0",
  "description": "A one-stop accessible tutorial on 6502 assembly language programming in the browser",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "clear": "rm -rf dist dist-app _site",
    "setup": "gem install bundler jekyll && bundle install",
    "build:vite": "vite build",
    "build": "gjsify run build:vite",
    "build:app": "gjsify build app.html --app browser --outfile dist-app/app.js --alias @gjsify/adwaita-fonts=@gjsify/empty",
    "dev:app": "vite --config vite.app.config.ts",
    "preview:app": "vite preview --config vite.app.config.ts",
    "check": "gjsify tsc --noEmit",
    "start:app": "gjsify run dist/main.js",
    "debug:app": "GTK_DEBUG=interactive gjsify run dist/main.js",
    "start": "bundle exec jekyll serve"
  },
  "author": "Pascal Garber <pascal@mailfreun.de>",
  "license": "GPL-3.0",
  "gjsify": {
    "loaders": {
      ".html": "text"
    }
  },
  "devDependencies": {
    "@gjsify/cli": "^0.16.3",
    "@gjsify/vite-plugin-gjsify": "^0.16.3",
    "lightningcss": "^1.32.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@gjsify/adwaita-web": "^0.16.3",
    "@learn6502/common-ui": "^0.7.0",
    "@learn6502/core": "^0.7.0",
    "@learn6502/learn": "^0.7.0"
  }
}
