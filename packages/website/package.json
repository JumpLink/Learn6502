{
  "name": "@learn6502/website",
  "version": "0.8.0",
  "description": "Static landing page for Learn 6502 Assembly, generated from the AppStream metainfo",
  "type": "module",
  "private": true,
  "scripts": {
    "clear": "rm -rf dist .cache",
    "build": "node src/cli.ts build",
    "start": "gjsify run build && vite preview",
    "check": "gjsify tsc --noEmit && node src/cli.ts i18n --check",
    "i18n": "node src/cli.ts i18n",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "author": "Pascal Garber <pascal@jumplink.eu>",
  "license": "GPL-3.0",
  "devDependencies": {
    "@gjsify/cli": "^0.61.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "sharp": "^0.35.5"
  }
}
